# --- META AI VIDEO GENERATOR CONFIG ---
# Instructions: Copy this file to .env and fill in the values.

# META_COOKIES: A JSON array of authenticated cookies from your browser session.
# Open meta.ai -> Log in -> Use "Cookie-Editor" (JSON export) -> Paste below.
# Example: META_COOKIES='[{"name": "datr", "value": "xyz"}, {"name": "ecto_1_sess", "value": "abc"}]'
META_COOKIES='[]'

# FFMPEG_PATH: Path to your ffmpeg.exe (needed if using the story engine)
FFMPEG_PATH='C:\ffmpeg\bin\ffmpeg.exe'

# VOICEBOX_BASE_URL: (Optional) If using the Voicebox TTS local server
VOICEBOX_BASE_URL='http://127.0.0.1:17493'
