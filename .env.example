# OpenAI / Llama API (via OpenRouter)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# VoiceBox Local TTS (https://voicebox.sh — runs on your machine)
# Make sure VoiceBox is running before starting the pipeline.
VOICEBOX_BASE_URL=http://127.0.0.1:17493
# Paste a profile ID from VoiceBox (leave blank to auto-select first profile)
VOICEBOX_PROFILE_ID=
# Language code for speech generation
VOICEBOX_LANGUAGE=en

# Project Configuration
FFMPEG_PATH=C:\ffmpeg\bin
MUSIC_FOLDER=music
OUTPUT_FOLDER=outputs
FINAL_VIDEOS_FOLDER=final_videos

# --- Google Drive Upload (Optional) ---
# Download from Cloud Console as credentials.json
GOOGLE_CREDENTIALS_PATH=credentials.json
# Auto-created on first run after browser login
GOOGLE_TOKEN_PATH=token.json
