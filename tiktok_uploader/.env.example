# TikTok Uploader Config
# Copy this file to .env and fill in your values.

# -----------------------------------------------------------
# TikTok settings
# -----------------------------------------------------------

# Your TikTok handle (without the @)
TIKTOK_ACCOUNT_NAME=your_tiktok_handle_here

# Randomised delays between actions to reduce bot-detection risk
TIKTOK_STEALTH_MODE=true

# -----------------------------------------------------------
# Google Drive settings
# -----------------------------------------------------------

# The folder that contains your finished .mp4 + _metadata.json pairs
# Get this from the Drive URL: drive.google.com/drive/folders/<FOLDER_ID>
DRIVE_VIDEOS_FOLDER_ID=your_google_drive_folder_id_here

# -----------------------------------------------------------
# OpenRouter LLM (for auto-generating TikTok captions)
# -----------------------------------------------------------

# Get your key at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Model to use — "openrouter/auto" picks the best free model automatically
# Free alternatives: "mistralai/mistral-7b-instruct:free"  "google/gemma-3-4b-it:free"
OPENROUTER_MODEL=openrouter/auto
